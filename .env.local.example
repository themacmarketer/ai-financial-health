# Copy this file to .env.local for local development.
# .env.local is gitignored - it must NEVER be committed.
#
# This key is read ONLY by the server-side function (api/gemini.ts).
# It is never bundled into the browser.
#
# On Vercel, set this same variable in:
#   Project -> Settings -> Environment Variables  (Production scope)
GEMINI_API_KEY=your-gemini-api-key-here
